# Database (local dev uses postgres:postgres; production should override)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# API always runs on 0.0.0.0:8000 (see bin/run.py) — not configurable here.

# LLM grading (Phase 2). Optional: unset means the deterministic chain only.
# Also used by pipeline service for term enrichment.
ANTHROPIC_API_KEY=

# Profanity check as the first grader in the deterministic chain. Default true.
ENABLE_PROFANITY_CHECK=true

# Docker Compose: optional services via profiles
# - pipeline: term ingestion Dagster service (set ANTHROPIC_API_KEY above to use)
# - dev: Vite dev-server with hot-reload (npm volumes mounted, slow on Mac)
