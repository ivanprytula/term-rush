# Node
node_modules/
dist/
.vite/

# Generated API client (regenerate via services/web's `npm run generate-client`)
services/web/openapi.json
services/web/src/client/

# Env & secrets — never commit real values, only .example files
.env
.env.*
!.env.example
*.tfvars
!*.tfvars.example

# Terraform
.terraform/
*.tfstate
*.tfstate.*

# Local tooling
.remember/
.DS_Store
.local-dev/

.claude/
.agents/
.impeccable/

.vscode/
