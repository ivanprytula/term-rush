# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Tool caches — redirected to the root .cache/ via pyproject settings
.cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
.import_linter_cache/
coverage/
